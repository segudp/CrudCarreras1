@model CrudCarreras1.Models.Instituto

@{
    ViewData["Title"] = "Editar Instituto";
}

<h2>@ViewData["Title"]</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="Id" />

    <div class="form-group">
        <label asp-for="Nombre" class="control-label">Nombre del Instituto</label>
        <input asp-for="Nombre" class="form-control" />
        <span asp-validation-for="Nombre" class="text-danger"></span>
    </div>
    <div class="form-group">
        <label asp-for="TipoInstituto" class="control-label"></label>
        <select asp-for="TipoInstituto" class="form-control">
            <option value="Privado">Privado</option>
            <option value="Público">Público</option>
        </select>
        <span asp-validation-for="TipoInstituto" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-success">Guardar cambios</button>
    <a asp-action="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
