@model List<IGrouping<string, CrudCarreras1.Models.Carrera>>
<h2>Carreras</h2>
<p>
    <a href="@Url.Action("Create")" class="btn btn-primary mb-3">
        <i class="bi bi-plus-circle"></i> Agregar Nueva Carrera
    </a>
</p>
@foreach (var grupo in Model)
{
    <hr class="my-4" />
    <h3 class="fw-bold">
        <span title="@(grupo.First().Instituto?.TipoInstituto == "Privado" ? "Institución privada" : "Institución pública")">
            @(grupo.First().Instituto?.TipoInstituto == "Privado" ? "🏫" : "🏛️")
        </span>
        @grupo.Key
    </h3>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Nombre</th>
                <th style="width: 250px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in grupo)
            {
                <tr>
                    <td>
                        @item.Nombre
                        <span class="text-muted" data-bs-toggle="tooltip" title="@item.Cuatrimestres cuatrimestre@(item.Cuatrimestres == 1 ? "" : "s")">
                            (@item.Cuatrimestres)
                        </span>
                    </td>
                    <td style="white-space: nowrap;">
                        <div class="d-flex gap-1">
                            <a href="@Url.Action("Details", new { id = item.ID })" class="btn btn-sm btn-info">
                                <i class="bi bi-eye"></i> Detalles
                            </a>
                            <a href="@Url.Action("Edit", new { id = item.ID })" class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil-square"></i> Editar
                            </a>
                            <a href="@Url.Action("Delete", new { id = item.ID })" class="btn btn-sm btn-danger">
                                <i class="bi bi-trash"></i> Eliminar
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}